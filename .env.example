# ==============================================================================
# OmniOPS Environment Configuration Template (.env.example)
# ==============================================================================
# IMPORTANT: This file is a safe, illustrative template. Never commit real production
# credentials, tokens, secret keys, or private certificates to source control.
# Copy this file to `.env` (or `.env.local`) for local development.
# Reference Documentation: docs/03-backend/BACKEND_SPECIFICATION.md
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE SERVER RUNTIME (apps/api) - Server-Side Only
# ------------------------------------------------------------------------------

# HTTP port the Express API listens on (Default: 4000)
PORT=4000

# Environment mode: development | test | production
NODE_ENV=development

# Base URL for the public React web application (used for CORS and redirect origins)
CLIENT_URL=http://localhost:3000

# Server logging level: trace | debug | info | warn | error | fatal
LOG_LEVEL=debug


# ------------------------------------------------------------------------------
# 2. DATABASE PERSISTENCE (MongoDB) - Server-Side Only
# ------------------------------------------------------------------------------

# MongoDB replica set connection URI
# Local development default points to the Docker Compose container
MONGODB_URI=mongodb://localhost:27017/omniops

# Optional MongoDB authentication credentials (leave empty if unauthenticated locally)
# MONGODB_USER=
# MONGODB_PASSWORD=


# ------------------------------------------------------------------------------
# 3. ENVELOPE ENCRYPTION & SECURITY - Server-Side Only
# ------------------------------------------------------------------------------

# Master Key Encryption Key (KEK) hex string (Must be exactly 64 hex characters = 256 bits)
# In production, this is managed via AWS KMS / GCP KMS rather than local disk.
# Generate a local dummy key with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MASTER_KEY_HEX=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Session secret used for signing session identifiers
SESSION_SECRET=dummy-insecure-local-session-secret-change-in-production


# ------------------------------------------------------------------------------
# 4. BACKGROUND QUEUE & WORKERS (Optional / Dev Toggle) - Server-Side Only
# ------------------------------------------------------------------------------

# Optional Redis connection URI if using BullMQ background queues
# REDIS_URI=redis://localhost:6379


# ------------------------------------------------------------------------------
# 5. CLIENT APPLICATION CONFIGURATION (apps/web) - Client-Exposed (Vite Prefix)
# ------------------------------------------------------------------------------
# WARNING: Variables prefixed with `VITE_` are embedded into public browser JavaScript
# bundles during build time. NEVER put secret keys or private tokens here!

# Base URL pointing to the OmniOPS Express REST API gateway
VITE_API_BASE_URL=http://localhost:4000/api/v1

# Application display name and branding
VITE_APP_NAME=OmniOPS

# Default client query cache stale time in milliseconds (Default: 30000 = 30 seconds)
VITE_QUERY_STALE_TIME_MS=30000
